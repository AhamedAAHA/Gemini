# Optional. Without these, BillScope runs fully locally (regex parser, rules
# engine, local Fin, in-memory persistence) so the demo always works.

# --- Persistence (DynamoDB) ---
BILLSCOPE_ANALYSES_TABLE=billscope_bills

# --- AWS ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Bedrock agent (Fin) ---
# Cheap model by default; escalates to the strong model for tool-using turns.
BILLSCOPE_CHEAP_MODEL=amazon.nova-micro-v1:0
BILLSCOPE_STRONG_MODEL=anthropic.claude-3-5-haiku-20241022-v1:0
# Optional semantic audit pass model (Claude). Set BILLSCOPE_SEMANTIC_MODEL to
# enable; leave unset to keep the audit deterministic-only.
BILLSCOPE_SEMANTIC_MODEL=
